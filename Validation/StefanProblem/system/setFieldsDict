FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha1 1
);

regions
(
    boxToCell
    {
        box (0 -1e-4 -1e-4) (4e-5 1e-4 1e-4);

        fieldValues
        (
            volScalarFieldValue alpha1 0
        );
    }
);

