FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha1 0
);

regions
(
    boxToCell
    {
        box (0 0 0) (1e-5 1e-5 1e-6);

        fieldValues
        (
            volScalarFieldValue alpha1 1
        );
    }
);

