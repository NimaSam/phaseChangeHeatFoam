FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha1 0
);

regions
(
    boxToCell
    {
        box (0 0 0) (5e-6 0.01 1e-7);

        fieldValues
        (
            volScalarFieldValue alpha1 1
        );
    }
);

