FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}

expressions
(
    alpha1
    {
        field       alpha1;
        dimensions  [0 0 0 0 0 0 0];

        expression
        #{
            pos
            (
                pos().y()
              - (
                    4.0/128.0*0.0023
                  + 1.0/128.0*0.0023
                   *cos(6.283185307179586*pos().x()/0.0023)
                )
            )
        #};
    }
);

