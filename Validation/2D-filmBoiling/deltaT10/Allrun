#!/bin/sh
cd ${0%/*} || exit 1

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

blockMesh
cp 0/alpha1.org 0/alpha1
cp 0/T.org 0/T

# non uniform initial Field 
setExprFields > log.setExprFields

# Run the solver
decomposePar

mpirun -np 8 phaseChangeHeatFoam -parallel > log 

reconstructPar

# Run post processing 
paraFoam -touchAll
